{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "next-dev",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "node_modules/next/dist/bin/next",
        "dev",
        "-p",
        "3000"
      ],
      "port": 3000
    },
    {
      "name": "homepage",
      "runtimeExecutable": "python",
      "runtimeArgs": [
        "-m",
        "http.server",
        "8080",
        "--bind",
        "127.0.0.1"
      ],
      "port": 8080
    },
    {
      "name": "static-export",
      "runtimeExecutable": "node",
      "runtimeArgs": [
        "scripts/serve-out.mjs"
      ],
      "env": {
        "PORT": "4173"
      },
      "port": 4173
    }
  ]
}
